{
  "expo": {
    "name": "Agroconecta",
    "slug": "agroconecta",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agroconecta.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A13"
      },
      "package": "com.agroconecta.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#FAFAFA",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Agroconecta necesita acceso a tus fotos para que puedas elegir una foto de perfil. La foto se guarda solo en tu dispositivo."
        }
      ],
      "expo-sharing",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "agroconecta",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7b7e211c-49ad-4dbe-b0b3-b0986a8eedfa"
      }
    }
  }
}
